# Configuración de producción de Siskoven.
#
# POR QUÉ ESTE ARCHIVO SÍ VA AL REPOSITORIO
#
# Todo lo de aquí lleva el prefijo NEXT_PUBLIC_, y eso significa que Next.js lo
# COMPILA DENTRO DEL JAVASCRIPT QUE SE ENVÍA AL NAVEGADOR. Cualquiera que abra
# la página puede leerlo con dos clics en las herramientas del desarrollador.
# No son secretos ni pueden serlo: son la dirección del proyecto, no su llave.
#
# Lo que protege una base de datos de Firebase no es esconder estos valores,
# son las reglas de seguridad (firestore.rules), que se ejecutan en el servidor
# de Google. Ahí es donde hay que mirar si preocupa la seguridad.
#
# Tenerlos aquí hace que el proyecto se construya solo, sin configurar nada en
# Vercel. Si algún día se cambia de proyecto de Firebase, se cambian aquí.
#
# LO QUE NO ESTÁ AQUÍ, Y NO DEBE ESTAR
#
# RECAPTCHA_SECRET_KEY. Esa sí es una llave de verdad: sin el prefijo público,
# vive solo en el servidor, y con ella cualquiera puede validar captchas en tu
# nombre. Va en el panel de Vercel (Settings -> Environment Variables).
#
# Hoy la que usas es la clave de PRUEBA que Google publica en su documentación,
# así que hoy no hay nada que proteger. Pero el día que pongas la de verdad, si
# este archivo ya tuviera el hueco, acabaría en el historial de git — y de ahí
# no se borra: queda en cada copia, cada rama y cada clon que alguien hiciera.

NEXT_PUBLIC_ADMIN_PHONE=
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBTem21DOBKKfXmbVk4Bu64FbXvtXwULew
NEXT_PUBLIC_FIREBASE_APP_ID=1:944881204670:web:4fd235cce5916ee9c70def
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=siskoven-24ff4.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_ID=default
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=944881204670
NEXT_PUBLIC_FIREBASE_PROJECT_ID=siskoven-24ff4
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=siskoven-24ff4.firebasestorage.app
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
