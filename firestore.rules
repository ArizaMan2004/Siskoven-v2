rules_version = '2';

// ============================================================================
// REGLAS DE SEGURIDAD DE SISKOVEN
// ============================================================================
//
// Esta es la autorización DE VERDAD. Lo que hay en lib/roles.ts solo decide qué
// botones se dibujan; cualquiera puede abrir la consola del navegador y llamar
// a Firestore directamente. Lo único que lo detiene es este archivo, porque se
// ejecuta en los servidores de Google.
//
// Modelo de datos: cada documento lleva `negocioId`. Una persona solo ve los
// documentos de su negocio, y lo que puede hacer con ellos depende de su rol,
// que se lee de usuarios/{uid}. El rol NO viaja en la petición: se consulta en
// la base, para que nadie pueda declararse dueño desde el cliente.
//
// Desplegar con:  firebase deploy --only firestore:rules
// Probar con:     firebase emulators:start --only firestore

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Ayudantes
    // ------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // El correo verificado es requisito: el registro manda un correo de
    // verificación y hasta que no se confirma, la cuenta no toca datos.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function myNegocio() {
      // Sin negocio explícito, el negocio es la propia cuenta: así una cuenta
      // de un solo dueño funciona sin configurar nada.
      return userDoc().get('negocioId', request.auth.uid);
    }

    // Ante la ausencia de rol se asume el más restrictivo.
    function myRole() {
      return userDoc().get('role', 'cashier');
    }

    // Super-administrador: tú, el dueño del SaaS. No es un rol dentro de un
    // negocio, es una lista aparte. El documento superAdmins/{uid} solo se crea
    // desde la consola de Firebase: ninguna regla permite escribir ahí, así que
    // nadie puede ascenderse a sí mismo ni aunque se salte todo lo demás.
    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    function isOwner() { return myRole() == 'owner'; }

    // El correo del token, en minúsculas y sin reventar si no viene ninguno.
    function miCorreo() {
      return request.auth.token.get('email', '').lower();
    }

    // La lista de permisos del usuario, copiada de su rol al asignárselo.
    //
    // Se guarda DENTRO del documento del usuario a propósito. Ir a buscar
    // roles/{id} costaría una lectura extra en cada venta, cada consulta y
    // cada guardado; el documento del usuario ya se lee aquí de todas formas.
    // El precio es reescribir a los miembros cuando cambia el rol, y eso pasa
    // una vez al mes. Ver lib/roles.ts.
    function myPermisos() {
      return userDoc().get('permisos', []);
    }

    // Cuentas anteriores a los roles por documento: no tienen lista, así que se
    // resuelve desde el rol que tenían entonces. Sin esto se quedarían sin poder
    // hacer nada de un día para otro, sin que nadie les hubiera quitado ningún
    // permiso.
    function permisoHeredado(permiso) {
      return myRole() == 'admin'
        ? !(permiso in ['users.manage', 'plan.manage'])
        : permiso in ['sales.create', 'sales.void', 'products.view',
                      'customers.view', 'cash.openShift', 'cash.closeOwnShift',
                      'cash.movements'];
    }

    // El dueño lo puede todo por definición: es el único que no se consulta en
    // ninguna lista. Si pudiera recortarse permisos a sí mismo se quedaría fuera
    // de su propio negocio sin nadie que se los devolviera.
    function puede(permiso) {
      return isOwner()
        || (myPermisos().size() > 0
              ? myPermisos().hasAny([permiso])
              : permisoHeredado(permiso));
    }

    // El alta de un empleado tiene que calcar su invitación: mismo negocio,
    // mismo rol y mismos permisos. Sin esta comprobación, tener una invitación
    // a un negocio bastaría para entrar en él como dueño.
    function invitacion() {
      return get(/databases/$(database)/documents/invitaciones/$(request.resource.data.get('invitacionId', 'x'))).data;
    }

    function uneteConInvitacion() {
      return request.resource.data.get('invitacionId', '') != ''
        && exists(/databases/$(database)/documents/invitaciones/$(request.resource.data.invitacionId))
        && invitacion().estado == 'pendiente'
        && invitacion().email == miCorreo()
        && request.resource.data.negocioId == invitacion().negocioId
        && request.resource.data.rolId == invitacion().rolId
        && request.resource.data.permisos == invitacion().permisos
        && request.resource.data.role == 'staff';
    }

    // La cuenta tiene que estar activa y sin vencer.
    //
    // `subscriptionEndsAt` manda sobre `trialEndsAt`: cuando alguien paga, su
    // suscripción sustituye a la prueba aunque el campo viejo siga ahí. Si no
    // hay ninguna de las dos fechas se deja pasar, para no dejar fuera a una
    // cuenta creada antes de que existiera este campo.
    function subscriptionActive() {
      let u = userDoc();

      // Un empleado no tiene suscripción propia: la que manda es la del
      // negocio, y el documento del negocio es el del dueño, porque `negocioId`
      // ES su uid. Sin esto, un comercio con el plan vencido seguiría entrando
      // todos los días por la cuenta de sus cajeros.
      // Si el negocio no tiene documento propio manda el del usuario. Pasa en
      // las cuentas antiguas, donde `negocioId` no era el uid del dueño: dejar
      // a alguien fuera por un dato que él no controla sería peor que el riesgo
      // que esto abre, que es el de una cuenta suelta sin negocio detrás.
      let cuenta = (u.get('role', 'staff') == 'owner'
                    || !exists(/databases/$(database)/documents/usuarios/$(u.get('negocioId', request.auth.uid))))
        ? u
        : get(/databases/$(database)/documents/usuarios/$(u.get('negocioId', request.auth.uid))).data;

      let vence = cuenta.get('subscriptionEndsAt', cuenta.get('trialEndsAt', null));

      // Las dos banderas: la del negocio (impago) y la de la persona (el dueño
      // le quitó el acceso). Cualquiera de las dos cierra la puerta.
      return cuenta.get('isActive', true) == true
        && u.get('isActive', true) == true
        && (vence == null || vence > request.time);
    }

    function member() {
      return verified() && subscriptionActive();
    }

    // El documento pertenece a mi negocio (lectura).
    function mine(resource) {
      return resource.data.get('negocioId', resource.data.get('userId', '')) == myNegocio();
    }

    // El documento que se está escribiendo se queda en mi negocio: impide
    // "mudar" un producto al negocio de otro.
    function staysMine() {
      return request.resource.data.negocioId == myNegocio();
    }

    // Ninguno de estos campos se toca en esta escritura.
    //
    // Se comprueba con `affectedKeys().hasAny(...)`, que es el modismo probado
    // de Firestore. La versión anterior usaba
    // `fields.toSet().hasOnly(...unchangedKeys())` y reventaba al evaluarse:
    // las pruebas del emulador lo cazaron: con ella, ningún usuario podía
    // guardar sus propios ajustes.
    function notChanging(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ------------------------------------------------------------------
    // usuarios
    // ------------------------------------------------------------------
    match /usuarios/{uid} {
      // Cada quien lee lo suyo; el dueño lee el de su equipo; el super-admin
      // lee todas, que es lo que hace posible el panel de administración.
      allow read: if signedIn()
                  && (request.auth.uid == uid || (isOwner() && mine(resource)) || isSuperAdmin());

      // Alta: solo tu propio documento y solo como dueño DE TU PROPIO negocio
      // (negocioId == tu uid). Eso es inofensivo: ser dueño de un negocio en el
      // que estás solo no da acceso a nada ajeno.
      //
      // Lo que sí se bloquea es entrar como dueño del negocio de OTRO, y
      // regalarse el plan completo: el plan lo asigna una Cloud Function tras
      // validar el código. Ahí estaba el agujero — el navegador escribía
      // plan:"complete" y se saltaba el pago.
      //
      // Un empleado no lo crea el dueño: crear la cuenta de otro desde el
      // navegador lo sacaría de la suya. Se invita, y la persona se registra
      // sola con su propio correo; entonces vale la segunda rama.
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.get('plan', 'trial') == 'trial'
                    && (
                         (request.resource.data.get('role', 'owner') == 'owner'
                          && request.resource.data.get('negocioId', uid) == uid)
                         || uneteConInvitacion()
                       );

      // Cada quien edita sus preferencias, pero jamás su rol, su plan, su
      // negocio ni la fecha de fin de prueba. Ahí estaba el agujero: el
      // navegador escribía plan:"complete" y se saltaba el pago.
      // `permisos` y `rolId` entran en la lista: quien pudiera editarse sus
      // propios permisos se daría acceso a los costos en dos clics.
      allow update: if signedIn()
                    && request.auth.uid == uid
                    && notChanging(['role', 'rolId', 'rolNombre', 'permisos', 'plan', 'negocioId', 'trialEndsAt', 'subscriptionEndsAt', 'isActive', 'exclusiveCode']);

      // Quien gestiona el equipo reparte roles, pero no puede tocar al dueño ni
      // fabricar otro: ni para ascender a nadie, ni para dejar al dueño sin
      // acceso a su propio negocio.
      allow update: if member() && puede('users.manage') && mine(resource)
                    && resource.data.get('role', 'staff') != 'owner'
                    && request.resource.data.get('role', 'staff') != 'owner'
                    && notChanging(['plan', 'negocioId', 'trialEndsAt', 'subscriptionEndsAt', 'exclusiveCode']);

      // El super-admin activa cuentas y mueve vencimientos: es lo único que
      // hace falta para cobrar suscripciones a mano.
      allow update: if isSuperAdmin();

      allow delete: if false; // las cuentas se desactivan, no se borran
    }

    // ------------------------------------------------------------------
    // negocios
    // ------------------------------------------------------------------
    match /negocios/{negocioId} {
      allow read: if member() && negocioId == myNegocio();
      allow create: if member() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if member() && puede('business.settings') && negocioId == myNegocio();
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // productos · costos · categorías
    //
    // El documento de producto NO contiene el costo ni el margen. Solo lleva
    // lo que el cajero necesita para vender: nombre, categoría, existencias y
    // precio de venta. El costo vive en productos_costos, que el cajero no
    // puede leer.
    //
    // Esto es necesario porque las reglas de Firestore autorizan documentos
    // ENTEROS, no campos sueltos: mientras el costo estuviera dentro del
    // producto, cualquier cajero podía verlo en la respuesta del servidor
    // aunque la pantalla no se lo mostrara. Separarlo es la única forma de que
    // "el cajero no ve costos" pase de disuasión a garantía.
    //
    // El margen (`profit`) también se guarda aparte: con el precio y el margen
    // se despeja el costo, así que dejarlo a la vista habría sido lo mismo que
    // publicar el costo.
    // ------------------------------------------------------------------
    match /productos/{productoId} {
      allow read: if member() && mine(resource);
      allow create: if member() && puede('products.create') && staysMine();
      allow update: if member() && puede('products.edit') && mine(resource) && staysMine();

      // Ajustar existencias es un permiso aparte del de editar: quien puede
      // cuadrar el stock puede tapar un faltante.
      allow update: if member() && puede('products.adjustStock') && mine(resource) && staysMine();

      // El cajero descuenta inventario al vender. Solo puede tocar `quantity`,
      // solo hacia abajo y sin dejarlo en negativo: eso es vender. Subirlo
      // sería ajustar stock, y ajustar stock es como se tapa un faltante.
      allow update: if member() && mine(resource) && staysMine()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity'])
                    && request.resource.data.quantity < resource.data.quantity
                    && request.resource.data.quantity >= 0;

      allow delete: if member() && puede('products.delete') && mine(resource);
    }

    // Costo y margen de cada producto. El identificador es el mismo que el del
    // producto, para poder emparejarlos sin una consulta extra.
    match /productos_costos/{productoId} {
      allow read: if member() && puede('costs.view') && mine(resource);
      allow write: if member() && puede('prices.edit') && staysMine();
    }

    // Costo de la mercancía en el momento de cada venta, que es lo que permite
    // calcular la utilidad y la reposición. El cajero lo ESCRIBE al vender
    // (necesita dejar constancia) pero no puede leerlo después.
    match /ventas_costos/{ventaId} {
      allow read: if member() && puede('costs.view') && mine(resource);
      allow create: if member() && staysMine();
      allow update, delete: if false;
    }

    match /categorias/{categoriaId} {
      allow read: if member() && mine(resource);
      allow write: if member() && puede('products.edit') && staysMine();
    }

    // ------------------------------------------------------------------
    // clientes
    // El cajero sí puede registrar un cliente nuevo en plena venta, pero no
    // borrarlo.
    // ------------------------------------------------------------------
    match /clientes/{clienteId} {
      allow read: if member() && puede('customers.view') && mine(resource);
      allow create: if member() && staysMine()
                    && (puede('customers.manage') || puede('sales.create'));

      // `receivables.collect` y `sales.credit` entran aquí porque el saldo de
      // deuda del cliente se mueve con increment() en el MISMO lote que la
      // deuda o el abono. Sin ellos, fiar o cobrar fallaría a mitad de lote y
      // dejaría una deuda que no suma en ningún resumen.
      allow update: if member() && mine(resource) && staysMine()
                    && (puede('customers.manage')
                        || puede('receivables.collect')
                        || puede('sales.credit'));

      allow delete: if false; // se desactivan: sus ventas y deudas apuntan aquí
    }

    // ------------------------------------------------------------------
    // ventas
    //
    // Una venta NO se borra y NO se reescribe. Si hubo un error se anula:
    // se marca `anulada` con motivo y autor, y queda el rastro de las dos
    // cosas. Un historial que se puede editar no es un historial.
    // ------------------------------------------------------------------
    match /ventas/{ventaId} {
      allow read: if member() && mine(resource)
                  // El cajero solo ve sus propias ventas; el encargado, todas.
                  && (puede('sales.viewAll') || resource.data.get('cajeroUid', '') == request.auth.uid);

      allow create: if member()
                    && puede('sales.create')
                    && staysMine()
                    && request.resource.data.cajeroUid == request.auth.uid
                    && request.resource.data.get('anulada', false) == false;

      // Lo único editable es la anulación, y solo una vez.
      allow update: if member() && mine(resource)
                    && resource.data.get('anulada', false) == false
                    && request.resource.data.anulada == true
                    && request.resource.data.anuladaPor == request.auth.uid
                    && request.resource.data.motivoAnulacion is string
                    && request.resource.data.motivoAnulacion.size() >= 3;

      // …y asignarle su correlativo a una venta que se guardó sin conexión.
      // Solo se permite pasar de "pendiente" a "numerada", nunca al revés ni
      // cambiar un número ya emitido.
      allow update: if member() && mine(resource)
                    && resource.data.get('pendienteDeNumerar', false) == true
                    && request.resource.data.pendienteDeNumerar == false
                    && request.resource.data.correlativo is int
                    && notChanging(['totalUsd', 'totalBs', 'items', 'cajeroUid', 'createdAt']);

      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // contadores de documentos
    //
    // Guardan el último correlativo emitido por negocio y tipo. Solo se pueden
    // tocar dentro de una transacción que además escriba el documento, pero eso
    // no se puede exigir desde aquí: las reglas ven cada escritura por separado.
    //
    // Lo que sí se exige, y es lo que importa: el contador solo SUBE, y de uno
    // en uno. Con esto, aunque alguien intente manipularlo desde la consola del
    // navegador, no puede retroceder la serie para reutilizar un número ni
    // saltarse tramos para tapar un documento.
    // ------------------------------------------------------------------
    match /contadores/{contadorId} {
      allow read: if member() && resource.data.negocioId == myNegocio();

      allow create: if member() && staysMine()
                    && request.resource.data.ultimo == 1;

      allow update: if member() && mine(resource) && staysMine()
                    && request.resource.data.ultimo == resource.data.ultimo + 1;

      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // cuentas · movimientos  (tesorería)
    //
    // Dónde vive el dinero. El saldo NO se recalcula al leer: se mantiene con
    // increment() dentro del mismo lote que escribe el movimiento.
    //
    // Por eso la regla del saldo es tan permisiva como tiene que serlo y ni un
    // poco más: quien pueda escribir movimientos puede mover el saldo, y eso
    // es exactamente lo que hace falta. Cuadrar saldo y movimientos desde las
    // reglas es imposible (no pueden sumar una colección); el control real es
    // que los movimientos son inmutables y siempre queda el rastro.
    // ------------------------------------------------------------------
    match /cuentas/{cuentaId} {
      // Ver dónde está el dinero es cosa de encargados y dueños. Un cajero no
      // tiene por qué saber cuánto hay en el banco.
      allow read: if member() && puede('accounts.view') && mine(resource);
      allow create: if member() && puede('accounts.manage') && staysMine();
      allow update: if member() && mine(resource) && staysMine();
      allow delete: if false; // se desactivan
    }

    match /movimientos/{movimientoId} {
      allow read: if member() && puede('accounts.view') && mine(resource);
      allow create: if member() && staysMine()
                    && request.resource.data.creadoPor == request.auth.uid;
      // Un movimiento no se retoca. Si se registró mal, se corrige con otro
      // movimiento en sentido contrario, y quedan los dos.
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // gastos · proveedores
    // ------------------------------------------------------------------
    match /gastos/{gastoId} {
      allow read: if member() && puede('expenses.view') && mine(resource);
      allow create: if member() && puede('expenses.create') && staysMine()
                    && request.resource.data.creadoPor == request.auth.uid;
      // Solo se puede apagar la recurrencia de un gasto fijo; el importe y el
      // concepto quedan como se registraron.
      allow update: if member() && puede('expenses.create') && mine(resource)
                    && notChanging(['montoUsd', 'montoBs', 'tipo', 'fecha', 'creadoPor']);
      allow delete: if false;
    }

    match /proveedores/{proveedorId} {
      allow read: if member() && mine(resource);
      allow create: if member() && puede('expenses.create') && staysMine();
      allow update: if member() && puede('expenses.create') && mine(resource) && staysMine();
      allow delete: if false; // se desactivan, para no romper el histórico
    }

    // ------------------------------------------------------------------
    // turnos de caja
    // ------------------------------------------------------------------
    match /turnos/{turnoId} {
      allow read: if member() && mine(resource)
                  && (puede('cash.closeAnyShift') || resource.data.get('cajeroUid', '') == request.auth.uid);

      allow create: if member()
                    && puede('cash.openShift')
                    && staysMine()
                    && request.resource.data.cajeroUid == request.auth.uid
                    && request.resource.data.estado == 'abierto';

      // Cierra su propio turno; el encargado puede cerrar el de cualquiera
      // (para cuando el cajero se fue sin cerrar).
      allow update: if member() && mine(resource)
                    && resource.data.estado == 'abierto'
                    && (puede('cash.closeAnyShift')
                        || (puede('cash.closeOwnShift')
                            && resource.data.cajeroUid == request.auth.uid));

      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // movimientos de caja (entradas y salidas que no son ventas)
    // ------------------------------------------------------------------
    match /movimientos_caja/{movimientoId} {
      allow read: if member() && mine(resource);
      allow create: if member() && staysMine()
                    && request.resource.data.creadoPor == request.auth.uid;
      allow update, delete: if false; // un movimiento de caja no se retoca
    }

    // ------------------------------------------------------------------
    // auditoría
    // Se escribe y no se toca nunca más. Ni el dueño puede reescribirla:
    // una bitácora editable no sirve para auditar a nadie.
    // ------------------------------------------------------------------
    match /auditoria/{registroId} {
      allow read: if member() && puede('reports.view') && mine(resource);
      allow create: if member() && staysMine()
                    && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // comprobantes de pago
    //
    // La captura del pago móvil y sus datos. Es la prueba de que el cliente
    // pagó, y la llave para cuadrar contra el estado de cuenta del banco.
    //
    // La LEE cualquiera que pueda vender, y no solo quien administra: el cajero
    // necesita comprobar, ANTES de entregar la mercancía, si esa referencia ya
    // se usó. Esa consulta es justamente la que caza la captura reenviada.
    // ------------------------------------------------------------------
    match /comprobantes/{comprobanteId} {
      allow read: if member() && mine(resource)
                  && (puede('sales.create') || puede('accounts.view'));

      allow create: if member() && puede('sales.create') && staysMine()
                    && request.resource.data.registradoPor == request.auth.uid
                    && request.resource.data.referencia is string
                    && request.resource.data.referencia.size() > 0
                    && request.resource.data.conciliado == false;

      // Lo único que se puede tocar después es marcarlo cuadrado contra el
      // banco. La referencia, el monto y la imagen quedan como se registraron:
      // un comprobante que se puede editar deja de ser una prueba.
      allow update: if member() && puede('accounts.view') && mine(resource)
                    && notChanging(['negocioId', 'referencia', 'montoBs', 'bancoCodigo',
                                    'imagenPath', 'imagenUrl', 'ventaId', 'registradoPor',
                                    'createdAt']);

      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // roles
    //
    // Los roles que crea el dueño. Este documento es la fuente de verdad para
    // EDITAR; lo que de verdad autoriza es la copia que vive en
    // usuarios/{uid}.permisos, porque es la que estas reglas pueden consultar
    // sin pagar una lectura extra en cada operación. Ver lib/roles.ts.
    // ------------------------------------------------------------------
    match /roles/{rolId} {
      allow read: if member() && puede('users.manage') && mine(resource);
      allow create: if member() && puede('users.manage') && staysMine();
      allow update: if member() && puede('users.manage') && mine(resource) && staysMine();
      allow delete: if member() && puede('users.manage') && mine(resource);
    }

    // ------------------------------------------------------------------
    // invitaciones
    //
    // Cómo entra alguien nuevo. El dueño no puede crear la cuenta de otro desde
    // el navegador (createUserWithEmailAndPassword lo sacaría de la suya), así
    // que deja una invitación y la persona se registra sola. De rebote, el
    // empleado elige su propia contraseña y el dueño nunca la sabe.
    // ------------------------------------------------------------------
    match /invitaciones/{invitacionId} {
      // La lee quien gestiona el equipo, y también su destinatario: sin esa
      // segunda lectura, la invitación no le serviría de nada a quien se está
      // registrando, que todavía no pertenece a ningún negocio.
      allow read: if signedIn()
                  && ((member() && puede('users.manage') && mine(resource))
                      || resource.data.email == miCorreo());

      allow create: if member() && puede('users.manage') && staysMine()
                    && request.resource.data.estado == 'pendiente';

      // Marcarla usada solo puede hacerlo su destinatario, y solo en ese
      // sentido: nadie puede reabrir una invitación ya gastada para colar a
      // otra persona con los mismos permisos.
      allow update: if signedIn()
                    && resource.data.email == miCorreo()
                    && resource.data.estado == 'pendiente'
                    && request.resource.data.estado == 'aceptada'
                    && request.resource.data.aceptadaPor == request.auth.uid
                    && notChanging(['negocioId', 'email', 'rolId', 'permisos']);

      // Retirar una invitación que aún no se usó sí se borra: no hay historial
      // que preservar, y dejarla ahí sería dejar una puerta abierta.
      allow delete: if member() && puede('users.manage') && mine(resource);
    }

    // ------------------------------------------------------------------
    // cuentas por cobrar · abonos  (el fiado)
    //
    // Una venta fiada es una venta completa: descuenta inventario, cuenta para
    // el reporte del día y numera su documento. Lo único distinto es que el
    // dinero no entró, y en vez de un movimiento de caja crea una deuda.
    //
    // El saldo se lleva en dos sitios a la vez —resumido en el cliente y
    // detallado aquí—, escritos en el mismo lote. Ver lib/customers.ts.
    // ------------------------------------------------------------------
    match /cuentas_cobrar/{deudaId} {
      allow read: if member() && puede('customers.view') && mine(resource);

      allow create: if member() && puede('sales.credit') && staysMine()
                    && request.resource.data.abonadoUsd == 0
                    && request.resource.data.saldoUsd == request.resource.data.montoUsd
                    && request.resource.data.montoUsd > 0;

      // Lo único que se mueve es lo abonado. El importe original, el cliente y
      // la venta que la originó quedan como se registraron: una deuda cuyo
      // monto se puede editar después no prueba nada.
      allow update: if member() && puede('receivables.collect')
                    && mine(resource) && staysMine()
                    && notChanging(['clienteId', 'montoUsd', 'ventaId', 'fecha', 'creadoPor'])
                    && request.resource.data.abonadoUsd >= resource.data.abonadoUsd
                    && request.resource.data.abonadoUsd <= resource.data.montoUsd
                    && request.resource.data.saldoUsd >= 0;

      allow delete: if false;
    }

    match /abonos/{abonoId} {
      allow read: if member() && puede('customers.view') && mine(resource);

      allow create: if member() && puede('receivables.collect') && staysMine()
                    && request.resource.data.registradoPor == request.auth.uid
                    && request.resource.data.montoUsd > 0;

      // Un abono no se retoca. Si se registró mal, se corrige con otro y quedan
      // los dos: es un recibo, y un recibo que se puede cambiar no es un recibo.
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // superAdmins
    //
    // Solo lectura, y solo de tu propia entrada: sirve para que la aplicación
    // sepa si mostrarte el panel. Crear o borrar entradas se hace únicamente
    // desde la consola de Firebase.
    // ------------------------------------------------------------------
    match /superAdmins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // pagos de suscripción
    //
    // El comercio puede ver sus propios pagos (su historial de facturación);
    // registrarlos es exclusivo del super-admin. No se editan ni se borran:
    // un recibo que se puede cambiar después no es un recibo.
    // ------------------------------------------------------------------
    match /pagos/{pagoId} {
      allow read: if isSuperAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSuperAdmin() && request.resource.data.registradoPor == request.auth.uid;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // códigos de registro
    //
    // Cerrado por completo al cliente. Antes el navegador leía la colección
    // para validar el código y luego lo marcaba como usado: cualquiera podía
    // listar los códigos válidos o marcar el suyo sin gastarlo.
    // Se valida desde una Cloud Function con el SDK de administrador.
    // ------------------------------------------------------------------
    match /admin_codes/{codigo} {
      allow read, write: if false;
    }

    // Todo lo que no esté contemplado arriba queda denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
